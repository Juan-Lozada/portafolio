{
  "name": "juan-lozada-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out",
    "preview": "serve out",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern dist --ignore-pattern .vinext --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docs:check": "node scripts/check-documentation.mjs",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm run test:run",
    "prebuild": "npm run check"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "leaflet": "^1.9.4",
    "lucide": "^1.34.0",
    "morphicons": "^1.7.0",
    "motion": "^13.1.1",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^30.0.1",
    "serve": "^14.2.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
