# URL canónica. En desarrollo se mantiene en localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ruta base para GitHub Pages. Vacía en localhost y en repositorios <usuario>.github.io.
# Ejemplo para un repositorio llamado portafolio: /portafolio
NEXT_PUBLIC_BASE_PATH=

# Se muestra como acceso público al código cuando está definida.
NEXT_PUBLIC_REPOSITORY_URL=

# Teselas públicas para la demostración. Mantener la atribución visible.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Los secretos reales nunca deben almacenarse en este proyecto estático.
